# Copy thành .env rồi điền giá trị: cp .env.example .env
# Biến đặt trong cấu hình MCP (claude mcp add -e ..., Codex env = {...}) được ưu tiên hơn file này.

# ── Bắt buộc ──────────────────────────────────────────────
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Nơi lưu dự án phim ────────────────────────────────────
# Mặc định: projects/ ngay trong thư mục này (scratch/omni/projects).
# Đường dẫn tương đối tính từ thư mục server; muốn để ngoài repo thì dùng đường dẫn tuyệt đối.
# FILM_PROJECTS_DIR=projects

# ── Model ─────────────────────────────────────────────────
# FILM_IMAGE_MODEL=gemini-3.1-flash-image   # character sheet, bối cảnh, storyboard
# FILM_VIDEO_MODEL=gemini-omni-1.1-flash    # ảnh → video (có thể tự nói thoại)
# FILM_TTS_MODEL=gemini-3.8-flash-tts       # thoại / lời dẫn
# FILM_MUSIC_MODEL=lyria-3.5                # nhạc nền

# ── Video ─────────────────────────────────────────────────
# Giới hạn độ dài 1 clip model sinh được (giây). Cảnh dài hơn sẽ giữ khung cuối.
# FILM_VIDEO_MIN_SEC=4
# FILM_VIDEO_MAX_SEC=10   # gemini-omni-1.1-flash tối đa 10s
# Thời gian tối đa chờ 1 clip (ms), mặc định 15 phút
# FILM_VIDEO_TIMEOUT_MS=900000

# ── Hiệu năng ─────────────────────────────────────────────
# Số request Gemini chạy song song trong 1 job (giảm nếu hay bị 429)
# FILM_CONCURRENCY=3

# ── Dashboard ─────────────────────────────────────────────
# Trang theo dõi chỉ đọc chạy kèm MCP server (http://localhost:4747); 0 = tắt
# FILM_DASHBOARD_PORT=4747

# ── Quota ─────────────────────────────────────────────────
# Bảng đơn giá để usage_report ước tính chi phí (xem pricing.example.json)
# FILM_PRICING_FILE=pricing.json

# ── ffmpeg (khi không nằm trong PATH) ─────────────────────
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# ── Proxy (máy chạy sau proxy công ty) ────────────────────
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1
